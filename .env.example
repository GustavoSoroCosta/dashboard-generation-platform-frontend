# Copy this file to ".env" and adjust to connect the app to a real backend.

# Base URL of the REST API (used only when VITE_USE_MOCK=false).
# O backend FastAPI corre, por omissão, em http://localhost:8000
VITE_API_URL=http://localhost:8000

# Use the built-in in-memory mock (no backend needed). Set to "false" to
# switch every data call over to the real API defined in VITE_API_URL.
VITE_USE_MOCK=true
